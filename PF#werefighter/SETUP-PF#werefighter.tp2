BACKUP ~PF#werefighter/backup~
AUTHOR ~P1nk-flaming0~
VERSION ~v1.0.5~
README ~PF#werefighter/README.md~
AUTO_EVAL_STRINGS

///////////////////////////////////////////////////////////////////////////////////////////

/// Language options
LANGUAGE 
"English"  
"english" 
"PF#werefighter/lang/english/setup.tra"

///////////////////////////////////////////////////////////////////////////////////////////

BEGIN ~Bloodmoon Reaver Kit~
// REQUIRE_* must sit immediately after BEGIN (before INCLUDE/actions), or WeiDU
// reports a GLR parse error. EE engines only; classic BG/IWD are not supported.
REQUIRE_PREDICATE GAME_IS ~bgee bg2ee eet iwdee~ @72

INCLUDE ~PF#werefighter/lib/fl#add_kit_ee.tpa~
// AT_INTERACTIVE_EXIT ~VIEW PF#werefighter/README.md~

///////////////////////////////////////////////////////////////////////////////////////////
//  Shared helper functions
///////////////////////////////////////////////////////////////////////////////////////////

// Idempotent, cross-mod-safe SPLPROT.2DA row append. Appends the row only if a
// row with this label doesn't already exist (UNLESS), then always re-reads the
// table to find and return the row's 0-based index, whether it pre-existed
// (installed by us on a previous run, or by another mod) or was just added.
DEFINE_ACTION_FUNCTION pf#add_splprot_row
STR_VAR
  label    = ""
  stat     = ""
  value    = ""
  relation = ""
RET
  row_index
BEGIN
  APPEND ~SPLPROT.2DA~ ~%label% %stat% %value% %relation%~ UNLESS ~%label%~

  OUTER_SET row_index = 0 - 1
  COPY_EXISTING ~SPLPROT.2DA~ ~override~
    COUNT_2DA_COLS pf_num_col
    READ_2DA_ENTRIES_NOW pf_rows pf_num_col
    FOR (pf_i = 0; pf_i < pf_rows; ++pf_i) BEGIN
      READ_2DA_ENTRY_FORMER pf_rows pf_i 0 pf_label
      PATCH_IF "%pf_label%" STRING_EQUAL_CASE "%label%" BEGIN
        SET row_index = pf_i
      END
    END
  BUT_ONLY
END

// Rewrites a single strref (dword) at `offset` in the file currently being
// patched, but only if its current value falls inside our legacy dev-tra
// range [103715,103785]. Live/already-migrated values fall outside this
// range and are left untouched, which is what makes the whole migration
// naturally idempotent across reinstalls.
DEFINE_PATCH_FUNCTION pf#fix_strref_at
INT_VAR
  offset = 0
BEGIN
  READ_LONG offset pf_old_ref
  PATCH_IF (pf_old_ref >= 103715) AND (pf_old_ref <= 103785) BEGIN
    SET pf_new_idx = pf_old_ref - 103714
    // AT looks up the TRA entry by numeric index; SPRINT gets the real text
    // ("In Distress"), then RESOLVE_STR_REF adds that text to dialog.tlk.
    // RESOLVE_STR_REF(~@%idx%~) would wrongly store the literal "@29".
    SPRINT pf_tra_text (AT "pf_new_idx")
    WRITE_LONG offset RESOLVE_STR_REF (~%pf_tra_text%~)
  END
END

// Generic legacy-strref migration. Operates on whatever resource is currently
// open via COPY_EXISTING. Dispatches on the file signature:
//  - SPL: header Unidentified Name (0x08) + Description (0x50), plus every
//    opcode 139 (Display String) / 330 (Float Text) feature-block parameter1,
//    discovered by walking every extended header's own feature-block range
//    (per IESDP: ext. header = 40 bytes, feature block = 48 bytes).
//  - ITM / CRE: header Unidentified/Long Name (0x08) + Identified/Short Name
//    (0x0C) only -- confirmed against every shipped .itm/.cre JSON dump that
//    none of our feature blocks on those resource types carry a legacy
//    strref, so there is nothing else to scan there.
DEFINE_PATCH_FUNCTION pf#fix_legacy_strrefs
BEGIN
  READ_ASCII 0x0 pf_sig (4)
  PATCH_IF ("%pf_sig%" STRING_EQUAL_CASE "SPL ") BEGIN
    LPF pf#fix_strref_at INT_VAR offset = 0x08 END
    LPF pf#fix_strref_at INT_VAR offset = 0x50 END

    READ_LONG  0x64 pf_ext_off
    READ_SHORT 0x68 pf_ext_cnt
    READ_LONG  0x6a pf_feat_off
    FOR (pf_h = 0; pf_h < pf_ext_cnt; ++pf_h) BEGIN
      READ_SHORT (pf_ext_off + (pf_h * 40) + 0x1e) pf_blk_cnt
      READ_SHORT (pf_ext_off + (pf_h * 40) + 0x20) pf_blk_idx
      FOR (pf_b = 0; pf_b < pf_blk_cnt; ++pf_b) BEGIN
        SET pf_abs = pf_feat_off + ((pf_blk_idx + pf_b) * 48)
        READ_SHORT pf_abs pf_opcode
        PATCH_IF (pf_opcode = 139) OR (pf_opcode = 330) BEGIN
          LPF pf#fix_strref_at INT_VAR offset = (pf_abs + 4) END
        END
      END
    END
  END ELSE PATCH_IF ("%pf_sig%" STRING_EQUAL_CASE "ITM ") BEGIN
    LPF pf#fix_strref_at INT_VAR offset = 0x08 END
    LPF pf#fix_strref_at INT_VAR offset = 0x0c END
  END ELSE PATCH_IF ("%pf_sig%" STRING_EQUAL_CASE "CRE ") BEGIN
    LPF pf#fix_strref_at INT_VAR offset = 0x08 END
    LPF pf#fix_strref_at INT_VAR offset = 0x0c END
  END
END

///////////////////////////////////////////////////////////////////////////////////////////
//  Phase 1 -- Resource deployment
///////////////////////////////////////////////////////////////////////////////////////////
// Deployed per-file (not per-folder) so that dev-only `.json` structural dumps
// living alongside the binaries in spl/, itm/, cre/ and eff/ never end up in
// the game's override folder. SPCL905.SPL is deliberately NOT copied here --
// it is a shared BG2EE/EET HLA carrier used by many kit mods, and is instead
// safely extended in Phase 5 (skipped on BG1EE where the resource is absent).

COPY
  ~PF#werefighter/spl/PF#FWAA0.SPL~   ~override~
  ~PF#werefighter/spl/PF#FWAA1.SPL~   ~override~
  ~PF#werefighter/spl/PF#FWAA2.SPL~   ~override~
  ~PF#werefighter/spl/PF#FWABF.SPL~   ~override~
  ~PF#werefighter/spl/PF#FWAFR.SPL~   ~override~
  ~PF#werefighter/spl/PF#FWAGW.SPL~   ~override~
  ~PF#werefighter/spl/PF#FWAPF.SPL~   ~override~
  ~PF#werefighter/spl/PF#FWAPS.SPL~   ~override~
  ~PF#werefighter/spl/PF#FWASU.SPL~   ~override~
  ~PF#werefighter/spl/PF#FWATS.SPL~   ~override~
  ~PF#werefighter/spl/PF#FWBF1.SPL~   ~override~
  ~PF#werefighter/spl/PF#FWBF2.SPL~   ~override~
  ~PF#werefighter/spl/PF#FWBF3.SPL~   ~override~
  ~PF#werefighter/spl/PF#FWBR0.SPL~   ~override~
  ~PF#werefighter/spl/PF#FWBR1.SPL~   ~override~
  ~PF#werefighter/spl/PF#FWBRS.SPL~   ~override~
  ~PF#werefighter/spl/PF#FWDIV.SPL~   ~override~
  ~PF#werefighter/spl/PF#FWEVL.SPL~   ~override~
  ~PF#werefighter/spl/PF#FWEX0.SPL~   ~override~
  ~PF#werefighter/spl/PF#FWEX1.SPL~   ~override~
  ~PF#werefighter/spl/PF#FWEXH.SPL~   ~override~
  ~PF#werefighter/spl/PF#FWGR9.SPL~   ~override~
  ~PF#werefighter/spl/PF#FWGRL.SPL~   ~override~
  ~PF#werefighter/spl/PF#FWGWU.SPL~   ~override~
  ~PF#werefighter/spl/PF#FWHWL.SPL~   ~override~
  ~PF#werefighter/spl/PF#FWLFR.SPL~   ~override~
  ~PF#werefighter/spl/PF#FWLG0.SPL~   ~override~
  ~PF#werefighter/spl/PF#FWLGW.SPL~   ~override~
  ~PF#werefighter/spl/PF#FWLSS.SPL~   ~override~
  ~PF#werefighter/spl/PF#FWLW0.SPL~   ~override~
  ~PF#werefighter/spl/PF#FWLWO.SPL~   ~override~
  ~PF#werefighter/spl/PF#FWLWR.SPL~   ~override~
  ~PF#werefighter/spl/PF#FWMSG.SPL~   ~override~
  ~PF#werefighter/spl/PF#FWNAT.SPL~   ~override~
  ~PF#werefighter/spl/PF#FWNF0.SPL~   ~override~
  ~PF#werefighter/spl/PF#FWPAY.SPL~   ~override~
  ~PF#werefighter/spl/PF#FWPGR.SPL~   ~override~
  ~PF#werefighter/spl/PF#FWPRD.SPL~   ~override~
  ~PF#werefighter/spl/PF#FWRMB.SPL~   ~override~
  ~PF#werefighter/spl/PF#FWRPL.SPL~   ~override~
