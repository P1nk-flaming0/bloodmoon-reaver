IF
    OnCreation()
THEN
    RESPONSE #100
        // 1. Play the "Call" sound so the player knows it worked
        PlaySound("PF#HWL5")
        
        // 2. Spawn the wolves just outside the player's camera
        // The '0,0,0' parameters handle coordinates and orientation automatically
        CreateCreatureObjectOffScreen("PF#WLFSU",Myself,0,0,0)
        SetGlobalTimer("PF_ProxyLifetime","LOCALS",20)
        Continue()
END

// Self-destruct when the timer expires
IF
    GlobalTimerExpired("PF_ProxyLifetime","LOCALS")
THEN
    RESPONSE #100
        DestroySelf()
END

// March toward the True Master through the Fog of War
IF
    !Range(LastSummonerOf(Myself),3)
THEN
    RESPONSE #100
        MoveToObject(LastSummonerOf(Myself))
END