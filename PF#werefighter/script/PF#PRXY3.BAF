// PHASE 1: Detect exact master slot via tight coordinate overlap
IF
    OnCreation()
    Range(Player1,1)
THEN
    RESPONSE #100
        SetGlobal("PF_CurrentSummoner","GLOBAL",1)
        Continue()
END

IF
    OnCreation()
    Range(Player2,1)
THEN
    RESPONSE #100
        SetGlobal("PF_CurrentSummoner","GLOBAL",2)
        Continue()
END

IF
    OnCreation()
    Range(Player3,1)
THEN
    RESPONSE #100
        SetGlobal("PF_CurrentSummoner","GLOBAL",3)
        Continue()
END

IF
    OnCreation()
    Range(Player4,1)
THEN
    RESPONSE #100
        SetGlobal("PF_CurrentSummoner","GLOBAL",4)
        Continue()
END

IF
    OnCreation()
    Range(Player5,1)
THEN
    RESPONSE #100
        SetGlobal("PF_CurrentSummoner","GLOBAL",5)
        Continue()
END

IF
    OnCreation()
    Range(Player6,1)
THEN
    RESPONSE #100
        SetGlobal("PF_CurrentSummoner","GLOBAL",6)
        Continue()
END

// PHASE 2: Spawn wolves and immediately vanish
IF
    OnCreation()
THEN
    RESPONSE #100
        PlaySound("PF#HWL7")
        CreateCreatureObjectOffScreen("PF#WLFSU",Myself,0,0,0)  // Dire Wolf
        CreateCreatureObjectOffScreen("PF#WLFSU",Myself,0,0,0)  // Dire Wolf
        CreateCreatureObjectOffScreen("PF#WLFSU",Myself,0,0,0)  // Dire Wolf
        CreateCreatureObjectOffScreen("PF#WLFSU",Myself,0,0,0)  // Dire Wolf
        DestroySelf()
END