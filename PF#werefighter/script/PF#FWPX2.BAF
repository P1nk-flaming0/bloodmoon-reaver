// Fallback safety block in case of an engine anomaly
IF
    OnCreation()
THEN
    RESPONSE #100
        SetGlobal("PF_CurrentSummoner","GLOBAL",1) // Default to Player 1
        PlaySound("PF#FWHL6")
        Wait(2)
        CreateCreatureObjectOffScreen("PF#FWFSU",Myself,0,0,0)
        CreateCreatureObjectOffScreen("PF#FWFSU",Myself,0,0,0)
        DestroySelf()
END