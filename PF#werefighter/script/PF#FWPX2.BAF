IF
    OnCreation()
    Range(Player1,3) // Wider range ensures it catches the overlapping caster
THEN
    RESPONSE #100
        SetGlobal("PF_CurrentSummoner","GLOBAL",1)
        PlaySound("PF#FWHL6")
        Wait(2)
        CreateCreatureObjectOffScreen("PF#FWFSU",Myself,0,0,0)
        CreateCreatureObjectOffScreen("PF#FWFSU",Myself,0,0,0)
        DestroySelf()
END

