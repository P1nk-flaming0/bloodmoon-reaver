IF
	ActionListEmpty()
	!See([ENEMY])
	!See([PC.0.0.0.WOLF_SUMMONER])
	Global("PF_MyMasterSlot","LOCALS",1)
THEN
	RESPONSE #100
		FollowObjectFormation(Player1,2,2)
END

