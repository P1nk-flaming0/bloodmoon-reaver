IF
	Global("PF_DOHWL","LOCALS",1)
THEN
	RESPONSE #10
		SetGlobal("PF_DOHWL","LOCALS",0)
		Wait(1)
		PlaySound("PF#FWHL5")
	RESPONSE #10
		SetGlobal("PF_DOHWL","LOCALS",0)
		Wait(1)
		PlaySound("PF#FWHL6")
	RESPONSE #10
		SetGlobal("PF_DOHWL","LOCALS",0)
		Wait(1)
		PlaySound("PF#FWHL8")
	RESPONSE #10
		SetGlobal("PF_DOHWL","LOCALS",0)
		Wait(1)
		PlaySound("PF#FWHL1")
	RESPONSE #10
		SetGlobal("PF_DOHWL","LOCALS",0)
		Wait(1)
		PlaySound("PF#FWHL9")
	RESPONSE #10
		SetGlobal("PF_DOHWL","LOCALS",0)
		Wait(2)
		PlaySound("PF#FWHL5")
	RESPONSE #10
		SetGlobal("PF_DOHWL","LOCALS",0)
		Wait(2)
		PlaySound("PF#FWHL6")
	RESPONSE #10
		SetGlobal("PF_DOHWL","LOCALS",0)
		Wait(1)
		PlaySound("PF#FWHL8")
	RESPONSE #10
		SetGlobal("PF_DOHWL","LOCALS",0)
		Wait(1)
		PlaySound("PF#FWHL1")
	RESPONSE #10
		SetGlobal("PF_DOHWL","LOCALS",0)
		Wait(1)
		PlaySound("PF#FWHL9")
END

IF
	Global("PF_MyMasterSlot","LOCALS",0)
	Global("PF_CurrentSummoner","GLOBAL",1)
THEN
	RESPONSE #100
		SetGlobal("PF_MyMasterSlot","LOCALS",1)
END

