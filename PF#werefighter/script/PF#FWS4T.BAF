// Catch-all for Ability 1
IF
    Global("PF_IS_WW","LOCALS",1)
    Global("PF_GAVE_FR","LOCALS",0)
THEN
    RESPONSE #100
        SetGlobal("PF_GAVE_FR","LOCALS",1)
END