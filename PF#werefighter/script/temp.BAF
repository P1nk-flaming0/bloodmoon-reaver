// 1. Reset on Rest
IF
    PartyRested()
THEN
    RESPONSE #100
        SetGlobal("PF_FW_HLA_FG_USED","LOCALS",0)
END

// 2. Track Usage
IF
    SpellCastInnate(Myself, "LATHANDER_BOON") // SPELL.IDS entry of your custom spell e.g. `LATHANDER_BOON`
THEN
    RESPONSE #100
        IncrementGlobal("PF_FW_HLA_FG_USED","LOCALS",1)
END

// ... [Include your other shapeshift logic here] ...

IF
    CheckSpellState(Myself, PRONE/* PF_IS_WEREWOLF */) // Use the ID Name from SPLSTATE.IDS
THEN
    RESPONSE #100
        DisplayStringHead(Myself, @15978) // for testing purposes
END

//

IF
    // HasItemEquipped("WOLF_ITEM", Myself) // Or use CheckStat/State for shapeshift
    // Global("K_Wolf_Form_Active","LOCALS",0) // Switch to ensure this runs once
    CheckSpellState(Myself, PRONE/* PF_IS_WEREWOLF */) // Use the ID Name from SPLSTATE.IDS
THEN
    RESPONSE #100
        // SetGlobal("K_Wolf_Form_Active","LOCALS",1)
        SetGlobal("K_Restore_Loop","LOCALS",0)
        Continue()
END

// This block loops to add the correct number of charges
IF
    Global("K_Wolf_Form_Active","LOCALS",1)
    GlobalsLT("K_Restore_Loop","K_HLA_A_MAX") // While Loop < Max
    CheckStatLT(Myself, 1, "PF_FW_MAX_FG")    // Logic check for remaining charges
THEN
    RESPONSE #100
        AddSpecialAbility("K_WOLF_A")
        IncrementGlobal("K_Restore_Loop","LOCALS",1)
END

//         SetGlobal("PF_FW_SHOW_MSG","LOCALS",1)

IF
    Global("K_Wolf_Form_Active","LOCALS",1)
    CheckStatGT(Myself, 0, 203) // Do I have at least 1 pick of the HLA?
    // ... remaining logic ...
THEN
    // You can use the value of Stat 115 directly in your math
     RESPONSE #100
        AddSpecialAbility("K_WOLF_A")
        IncrementGlobal("K_Restore_Loop","LOCALS",1)
END


// --- DETECT WEREWOLF FORM ---
IF
    Global("PF_IS_WEREWOLF_VAR","LOCALS",1) // Variable set by Opcode 309
    Global("Form_Logic_Lock","LOCALS",0)   // Prevent the script from stuttering/looping
THEN
    RESPONSE #100
        SetGlobal("Form_Logic_Lock","LOCALS",1) // "Lock" the logic
        // Add your Werewolf-only items or HLAs here
        AddSpecialAbility("K_WOLF_A") 
        DisplayStringHead(Myself, @2000) // "The beast awakens..."
END

// --- DETECT HUMAN FORM ---
IF
    Global("PF_IS_WEREWOLF_VAR","LOCALS",0) // Variable set by Opcode 309
    Global("Form_Logic_Lock","LOCALS",1)   // Check if we were previously a wolf
THEN
    RESPONSE #100
        SetGlobal("Form_Logic_Lock","LOCALS",0) // "Unlock" for next transformation
        // Cleanup: Remove werewolf abilities
        RemoveSpellRes("K_WOLF_A")
        DisplayStringHead(Myself, @2001) // "The blood cools..."
END

// ----------------------------------------------------------------------

// 1. Reset on Rest
IF
    PartyRested()
THEN
    RESPONSE #100
        SetGlobal("PF_R_USD","LOCALS",0)
END

// ... [Include your other shapeshift logic here] ...

IF
    CheckSpellState(Myself, PRONE/* PF_IS_WEREWOLF */) // Use the ID Name from SPLSTATE.IDS
THEN
    RESPONSE #100
        DisplayStringHead(Myself, @15978) // for testing purposes
END

//

IF
    CheckSpellState(Myself, PRONE/* PF_IS_WEREWOLF */) // Use the ID Name from SPLSTATE.IDS
THEN
    RESPONSE #100
        // SetGlobal("PF_IS_WW","LOCALS",1)
        SetGlobal("PF_RLOOP","LOCALS",0)
        Continue()
END

// This block loops to add the correct number of charges
IF
    Global("PF_IS_WW","LOCALS",1)
    GlobalsLT("PF_RLOOP","PF_MAX_R") // While Loop < Max
    CheckStatLT(Myself, 1, "PF_FW_MAX_FG")    // Logic check for remaining charges
THEN
    RESPONSE #100
        AddSpecialAbility("PF#SPLFR")
        IncrementGlobal("PF_RLOOP","LOCALS",1)
END

IF
    Global("PF_IS_WW","LOCALS",1)
    CheckStatGT(Myself, 0, 203) // Do I have at least 1 pick of the HLA?
    // CheckStat(Myself, ...)
    // ... remaining logic ...
THEN
    // You can use the value of Stat 203 directly in your math
END

IF
    Global("PF_IS_WW","LOCALS",1)
    CheckStat(Myself, 3, 203)           // If Max is 3...
    GlobalLT("PF_R_USD","LOCALS",3) // ...and I've used fewer than 3...
    !HaveSpellRES("PF#SPLFR")           // ...and the slot is empty...
THEN
    RESPONSE #100
        AddSpecialAbility("PF#SPLFR")
        // Use Opcode 261 via a sub-spell if you need to "refill" specific counts
END

// --- DETECT WEREWOLF FORM ---
IF
    Global("PF_IS_WEREWOLF_VAR","LOCALS",1) // Variable set by Opcode 309
    Global("Form_Logic_Lock","LOCALS",0)   // Prevent the script from stuttering/looping
THEN
    RESPONSE #100
        SetGlobal("Form_Logic_Lock","LOCALS",1) // "Lock" the logic
        // Add your Werewolf-only items or HLAs here
        AddSpecialAbility("K_WOLF_A") 
        DisplayStringHead(Myself, @2000) // "The beast awakens..."
END

// --- DETECT HUMAN FORM ---
IF
    Global("PF_IS_WEREWOLF_VAR","LOCALS",0) // Variable set by Opcode 309
    Global("Form_Logic_Lock","LOCALS",1)   // Check if we were previously a wolf
THEN
    RESPONSE #100
        SetGlobal("Form_Logic_Lock","LOCALS",0) // "Unlock" for next transformation
        // Cleanup: Remove werewolf abilities
        RemoveSpellRes("K_WOLF_A")
        DisplayStringHead(Myself, @2001) // "The blood cools..."
END

/* 

Local Variables
PF_IS_WW = Is char in werewolf form // use either this or PF_IS_WEREWOLF
PF_MAX_R = MAX picked uses Rage ability // Superfluous since we will use PF_FW_MAX_FG
PF_R_USD = # of expended ability uses
PF_RLOOP = restore loop 

STATS.IDS
203 PF_FW_MAX_FG = Max uses of Feral Rage user currently has

SPLSTATE.IDS 
166 PF_IS_WEREWOLF // use either this or PF_IS_WW

*/

// !@#!@#!@#!@############################################


// 1. Reset on Rest
IF
    PartyRested()
THEN
    RESPONSE #100
        SetGlobal("PF_R_USD","LOCALS",0)
END

IF
    CheckSpellState(Myself, PF_IS_WEREWOLF) // Use the ID Name from SPLSTATE.IDS
THEN
    RESPONSE #100
        // SetGlobal("PF_IS_WW","LOCALS",1)
        SetGlobal("PF_RLOOP","LOCALS",0)
        Continue()
END

// This block loops to add the correct number of charges
IF
    Global("PF_IS_WW","LOCALS",1)
    GlobalsLT("PF_RLOOP","PF_MAX_R") // While Loop < Max
    CheckStatLT(Myself, 1, "PF_FW_MAX_FG")    // Logic check for remaining charges
THEN
    RESPONSE #100
        AddSpecialAbility("PF#SPLFR")
        IncrementGlobal("PF_RLOOP","LOCALS",1)
END

IF
    Global("PF_IS_WW","LOCALS",1)
    CheckStatGT(Myself, 0, 203) // Do I have at least 1 pick of the HLA?
    // ... remaining logic ...
THEN
    // You can use the value of Stat 203 directly in your math
END

IF
    Global("PF_IS_WW","LOCALS",1)
    CheckStat(Myself, 3, 203)           // If Max is 3...
    GlobalLT("PF_R_USD","LOCALS",3) // ...and I've used fewer than 3...
    !HaveSpellRES("PF#SPLFR")           // ...and the slot is empty...
THEN
    RESPONSE #100
        AddSpecialAbility("PF#SPLFR")
        // Use Opcode 261 via a sub-spell if you need to "refill" specific counts
END

// --- DETECT WEREWOLF FORM ---
IF
    Global("PF_IS_WW","LOCALS",1) // Variable set by Opcode 309
    Global("Form_Logic_Lock","LOCALS",0)   // Prevent the script from stuttering/looping
THEN
    RESPONSE #100
        SetGlobal("Form_Logic_Lock","LOCALS",1) // "Lock" the logic
        // Add your Werewolf-only items or HLAs here
        AddSpecialAbility("K_WOLF_A") 
        DisplayStringHead(Myself, @2000) // "The beast awakens..."
END

// --- DETECT HUMAN FORM ---
IF
    Global("PF_IS_WW","LOCALS",0) // Variable set by Opcode 309
    Global("Form_Logic_Lock","LOCALS",1)   // Check if we were previously a wolf
THEN
    RESPONSE #100
        SetGlobal("Form_Logic_Lock","LOCALS",0) // "Unlock" for next transformation
        // Cleanup: Remove werewolf abilities
        RemoveSpellRes("K_WOLF_A")
        DisplayStringHead(Myself, @2001) // "The blood cools..."
END

/* 

Local Variables
PF_IS_WW = Is char in werewolf form // use either this or PF_IS_WEREWOLF
PF_MAX_R = MAX picked uses Rage ability // Superfluous since we will use PF_FW_MAX_FG
PF_R_USD = # of expended ability uses
PF_RLOOP = restore loop 

STATS.IDS
203 PF_FW_MAX_FG = Max uses of Feral Rage user currently has

SPLSTATE.IDS 
166 PF_IS_WEREWOLF // use either this or PF_IS_WW

.SPL
PF#SPLFR = HLA's main spl name
*/