IF
     // Detect the "tag" from the caster's spell
    Global("PF_DOHWL","LOCALS",1)
THEN
    // 1 Second Delays (Approx 50% total)
    RESPONSE #10
        SetGlobal("PF_DOHWL","LOCALS",0) // Reset immediately so it doesn't loop
        Wait(1)
        PlaySound("PF#FWHL5")
    RESPONSE #10
        SetGlobal("PF_DOHWL","LOCALS",0)
        Wait(1)
        PlaySound("PF#FWHL6")
    RESPONSE #10
        SetGlobal("PF_DOHWL","LOCALS",0)
        Wait(1)
        PlaySound("PF#FWHL8")
    RESPONSE #10
        SetGlobal("PF_DOHWL","LOCALS",0)
        Wait(1)
        PlaySound("PF#FWHL1")
    RESPONSE #10
        SetGlobal("PF_DOHWL","LOCALS",0)
        Wait(1)
        PlaySound("PF#FWHL9")

    // 2 Second Delays (Approx 50% total)
    RESPONSE #10
        SetGlobal("PF_DOHWL","LOCALS",0)
        Wait(2)
        PlaySound("PF#FWHL5")
    RESPONSE #10
        SetGlobal("PF_DOHWL","LOCALS",0)
        Wait(2)
        PlaySound("PF#FWHL6")
    RESPONSE #10
        SetGlobal("PF_DOHWL","LOCALS",0)
        Wait(1)
        PlaySound("PF#FWHL8")
    RESPONSE #10
        SetGlobal("PF_DOHWL","LOCALS",0)
        Wait(1)
        PlaySound("PF#FWHL1")
    RESPONSE #10
        SetGlobal("PF_DOHWL","LOCALS",0)
        Wait(1)
        PlaySound("PF#FWHL9")

END

// ===================================================================
// HANDSHAKE: Capture the master's slot ID locally on spawn
// ===================================================================
IF
    Global("PF_MyMasterSlot","LOCALS",0)
    Global("PF_CurrentSummoner","GLOBAL",1)
THEN
    RESPONSE #100
        SetGlobal("PF_MyMasterSlot","LOCALS",1)
END

IF
    Global("PF_MyMasterSlot","LOCALS",0)
    Global("PF_CurrentSummoner","GLOBAL",2)
THEN
    RESPONSE #100
        SetGlobal("PF_MyMasterSlot","LOCALS",2)
END

IF
    Global("PF_MyMasterSlot","LOCALS",0)
    Global("PF_CurrentSummoner","GLOBAL",3)
THEN
    RESPONSE #100
        SetGlobal("PF_MyMasterSlot","LOCALS",3)
END

IF
    Global("PF_MyMasterSlot","LOCALS",0)
    Global("PF_CurrentSummoner","GLOBAL",4)
THEN
    RESPONSE #100
        SetGlobal("PF_MyMasterSlot","LOCALS",4)
END

IF
    Global("PF_MyMasterSlot","LOCALS",0)
    Global("PF_CurrentSummoner","GLOBAL",5)
THEN
    RESPONSE #100
        SetGlobal("PF_MyMasterSlot","LOCALS",5)
END

IF
    Global("PF_MyMasterSlot","LOCALS",0)
    Global("PF_CurrentSummoner","GLOBAL",6)
THEN
    RESPONSE #100
        SetGlobal("PF_MyMasterSlot","LOCALS",6)
END

// ===================================================================
// PHASE 1: Track Master through Fog of War using Explicit Slot Pointers
// ===================================================================
IF
    ActionListEmpty()
    !See([ENEMY])
    !See([PC.0.0.0.WOLF_SUMMONER]) // True Master is not visible yet
    Global("PF_MyMasterSlot","LOCALS",1)
THEN
    RESPONSE #100
        MoveToObject(Player1)
END

IF
    ActionListEmpty()
    !See([ENEMY])
    !See([PC.0.0.0.WOLF_SUMMONER])
    Global("PF_MyMasterSlot","LOCALS",2)
THEN
    RESPONSE #100
        MoveToObject(Player2)
END

IF
    ActionListEmpty()
    !See([ENEMY])
    !See([PC.0.0.0.WOLF_SUMMONER])
    Global("PF_MyMasterSlot","LOCALS",3)
THEN
    RESPONSE #100
        MoveToObject(Player3)
END

IF
    ActionListEmpty()
    !See([ENEMY])
    !See([PC.0.0.0.WOLF_SUMMONER])
    Global("PF_MyMasterSlot","LOCALS",4)
THEN
    RESPONSE #100
        MoveToObject(Player4)
END

IF
    ActionListEmpty()
    !See([ENEMY])
    !See([PC.0.0.0.WOLF_SUMMONER])
    Global("PF_MyMasterSlot","LOCALS",5)
THEN
    RESPONSE #100
        MoveToObject(Player5)
END

IF
    ActionListEmpty()
    !See([ENEMY])
    !See([PC.0.0.0.WOLF_SUMMONER])
    Global("PF_MyMasterSlot","LOCALS",6)
THEN
    RESPONSE #100
        MoveToObject(Player6)
END

// ===================================================================
// PHASE 2: Fall into formation once Master is within Visual Range
// ===================================================================
IF
    ActionListEmpty()
    !See([ENEMY])
    See([PC.0.0.0.WOLF_SUMMONER])  // Master found visually!
    !Range([PC.0.0.0.WOLF_SUMMONER],10)
THEN
    RESPONSE #100
        FollowObjectFormation([PC.0.0.0.WOLF_SUMMONER],2,2)
END

