    Global("PF_IS_WW","LOCALS",1)
    Global("PF_GAVE_FR","LOCALS",0)
    CheckStat(Myself,4,134)
    Global("PF_R_USD","LOCALS",2)
THEN
    RESPONSE #100
        SetGlobal("PF_GAVE_FR","LOCALS",1)
        ApplySpellRES("PF#APFR",Myself)
        ApplySpellRES("PF#APFR",Myself)
END

// CASE: 2 Charges (3-1)
IF
    Global("PF_IS_WW","LOCALS",1)
    Global("PF_GAVE_FR","LOCALS",0)
    CheckStat(Myself,3,134)
    Global("PF_R_USD","LOCALS",1)
THEN
    RESPONSE #100
        SetGlobal("PF_GAVE_FR","LOCALS",1)
        ApplySpellRES("PF#APFR",Myself)
        ApplySpellRES("PF#APFR",Myself)
END

// CASE: 2 Charges (2-0)
IF
    Global("PF_IS_WW","LOCALS",1)
    Global("PF_GAVE_FR","LOCALS",0)
    CheckStat(Myself,2,134)
    Global("PF_R_USD","LOCALS",0)
THEN
    RESPONSE #100
        SetGlobal("PF_GAVE_FR","LOCALS",1)
        ApplySpellRES("PF#APFR",Myself)
        ApplySpellRES("PF#APFR",Myself)
END

// ------------------------------------------------------------------------------------------------
// 5. Ability 1: PF#SPLFR (The "Math" Blocks) — rewritten OR(5) -> 5 separate IFs
// ------------------------------------------------------------------------------------------------

