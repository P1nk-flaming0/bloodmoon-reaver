// Optional IWDEE patch: grant kit HLAs via CLAB at levels 20-30 and swap HELP text.
// Requires core kit component (DESIGNATED 100). Uninstall restores prior CLAB/HELP.

// Replace the kit ability table installed by ADD_KIT (source path PF#CLBFW.2da).
COPY ~PF#werefighter/2da/pf#cbfwi.2da~ ~override/PF#CLBFW.2DA~

// Point kitlist HELP and EE clastext DESCRIPTION at the HLA-integrated description.
OUTER_SET pf#hla_kit_desc = RESOLVE_STR_REF (@81)

COPY_EXISTING ~kitlist.2da~ ~override~
  COUNT_2DA_COLS cols
  READ_2DA_ENTRIES_NOW rows cols
  FOR (i = 0; i < rows; ++i) BEGIN
    READ_2DA_ENTRY_FORMER rows i 1 kit_id
    PATCH_IF ~%kit_id%~ STRING_EQUAL_CASE ~PF#werefighter~ BEGIN
      SET_2DA_ENTRY i 4 cols ~%pf#hla_kit_desc%~
    END
  END
BUT_ONLY

ACTION_IF FILE_EXISTS_IN_GAME ~clastext.2da~ BEGIN
  COPY_EXISTING ~clastext.2da~ ~override~
    COUNT_2DA_COLS cols
    READ_2DA_ENTRIES_NOW rows cols
    FOR (i = 0; i < rows; ++i) BEGIN
      READ_2DA_ENTRY_FORMER rows i 0 kit_id
      PATCH_IF ~%kit_id%~ STRING_EQUAL_CASE ~PF#werefighter~ BEGIN
        // DESCSTR column (index 4)
        SET_2DA_ENTRY i 4 cols ~%pf#hla_kit_desc%~
      END
    END
  BUT_ONLY
END
